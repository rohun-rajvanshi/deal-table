# Copy this file to .env and fill it in.
# Leave the database settings out to use the built-in database (stored in DATA_DIR, default ./data).
# PostgreSQL connection string (Azure example shown).
# DATABASE_URL=postgres://dealadmin:YOUR_PASSWORD@your-server.postgres.database.azure.com:5432/dealtable

# ...or, instead of DATABASE_URL, the separate settings (no URL-encoding needed):
# PGHOST=your-server.postgres.database.azure.com
# PGUSER=dealadmin
# PGPASSWORD=YOUR_PASSWORD
# PGDATABASE=dealtable

# Port to listen on (Azure App Service sets this for you).
PORT=3000

# TLS to the database is on automatically for non-local hosts. Use PGSSL=disable for a local Postgres.
# PGSSL=disable
